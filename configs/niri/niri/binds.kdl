binds {
    // 键由用加号分隔的修饰键组成，最后是一个 XKB 键名。
    // 若要查找某个键的 XKB 名称，可使用类似 wev 的程序。
    //
    // 当在 TTY 上运行时，"Mod" 是等同于 Super 的特殊修饰键；
    // 在以 winit 作为窗口时，等同于 Alt。
    //
    // 大多数在此绑定的操作也可以通过编程方式调用，使用 `niri msg action do-something`。

    // Mod+Shift+/（通常等同于 Mod+?）会显示重要热键列表。
    Mod+Shift+Slash hotkey-overlay-title="显示重要热键" { show-hotkey-overlay; }

    // Shell 命令
    //
    // Shell 启动器的绑定由 shell-switcher-binds.kdl 管理。
    // 如需，可取消注释并自定义更多与 shell 相关的快捷键。
    // Mod+Ctrl+Space hotkey-overlay-title="Open Overview" { toggle-overview; }

    // 建议的程序运行绑定：终端、应用启动器、锁屏程序。

    Mod+T hotkey-overlay-title="打开终端：kitty" { spawn "kitty"; }
    Mod+Return hotkey-overlay-title="打开终端：kitty" { spawn "kitty"; }
    Mod+F hotkey-overlay-title="打开文件管理器" { spawn "nemo"; }
    Mod+N hotkey-overlay-title="打开 QQ" { spawn-sh "id=$(niri msg -j windows | jq -r '.[] | select(.app_id==\"QQ\") | .id' | head -n1); [ -n \"$id\" ] && niri msg action focus-window --id \"$id\" || exec linuxqq"; }
    Mod+M hotkey-overlay-title="打开微信" { spawn-sh "id=$(niri msg -j windows | jq -r '.[] | select(.app_id==\"wechat\") | .id' | head -n1); [ -n \"$id\" ] && niri msg action focus-window --id \"$id\" || exec wechat"; }
    Mod+D hotkey-overlay-title="打开 DeepSeek" { spawn-sh "id=$(niri msg -j windows | jq -r '.[] | select((.app_id // \"\" | contains(\"hmjcdonmhijmnefklekckjkeoknbiipb\")) or ((.title // \"\") | ascii_downcase | contains(\"deepseek\"))) | .id' | head -n1); [ -n \"$id\" ] && niri msg action focus-window --id \"$id\" || gtk-launch chrome-hmjcdonmhijmnefklekckjkeoknbiipb-Default"; }
    Mod+Shift+D hotkey-overlay-title="打开豆包" { spawn-sh "id=$(niri msg -j windows | jq -r '.[] | select((.app_id // \"\" | contains(\"nfjhphkhjelhenadmhihghlkccjdpdkk\")) or ((.title // \"\") | contains(\"豆包\"))) | .id' | head -n1); [ -n \"$id\" ] && niri msg action focus-window --id \"$id\" || gtk-launch chrome-nfjhphkhjelhenadmhihghlkccjdpdkk-Default"; }
    Mod+Shift+N hotkey-overlay-title="打开 Obsidian" { spawn "obsidian"; }
    Mod+G hotkey-overlay-title="打开 Telegram" { spawn "Telegram"; }
    Mod+B hotkey-overlay-title="打开 Chrome" { spawn "google-chrome-stable"; }
    // Mod+Shift+Z hotkey-overlay-title="打开 Zed 编辑器" { spawn "sh" "-c" "$HOME/.config/niri/Scripts/zed-resize-fix.sh"; }
    Mod+S hotkey-overlay-title="打开 Steam" { spawn "steam"; }
    Mod+Ctrl+C hotkey-overlay-title="打开 Codex-cli" { spawn "kitty" "codex"; }
    Mod+Ctrl+Return { spawn "kitty" "--class=floating-kitty"; }
    Mod+Shift+O hotkey-overlay-title="打开 OBS Studio" { spawn "flatpak" "run" "com.obsproject.Studio"; }
    Super+Alt+L hotkey-overlay-title="锁屏：swaylock" { spawn "swaylock"; }

    // 使用 spawn-sh 来运行一个 shell 命令。当你需要使用管道、多个命令等时请使用它。
    // 注意：整个命令作为单个参数传入，会按原样传递给 `sh -c` 。
    // 例如，这是一个切换屏幕阅读器（orca）的标准绑定。
    Super+Alt+S allow-when-locked=true hotkey-overlay-title=null { spawn-sh "pkill orca || exec orca"; }

    // 以下为 PipeWire 与 WirePlumber 的示例音量键映射。
    // 属性 allow-when-locked=true 使其在会话锁定时仍然可用。
    // 使用 spawn-sh 可以在命令中传入多个参数。
    // "-l 1.0" 将音量限制为 100%。
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    // 使用 playerctl 的示例媒体键映射。
    // 这将与任何支持 MPRIS 的媒体播放器配合工作。
    XF86AudioPlay        allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop        allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "playerctl next"; }

    // 使用 brightnessctl 的示例亮度键映射。
    // 你也可以使用普通的 spawn 并传入多个参数（以避免通过 "sh"），
    // 但需要手动将每个参数用单独的 "" 引号包裹。
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }

    // 打开/关闭 Overview：工作区和窗口的缩略视图。
    // 你也可以将鼠标移动到左上角热区，或在触控板上四指向上滑动。
    Mod+X repeat=false { toggle-overview; }

    Mod+Q repeat=false hotkey-overlay-title="关闭当前窗口" { close-window; }

    Mod+Left  hotkey-overlay-title="聚焦左侧列" { focus-column-left; }
    Mod+Down  hotkey-overlay-title="切换到下方工作区" { focus-workspace-down; }
    Mod+Up    hotkey-overlay-title="切换到上方工作区" { focus-workspace-up; }
    Mod+Right hotkey-overlay-title="聚焦右侧列" { focus-column-right; }
    Mod+H     hotkey-overlay-title="聚焦左侧列" { focus-column-left; }
    Mod+J     hotkey-overlay-title="切换到下方工作区" { focus-workspace-down; }
    Mod+K     hotkey-overlay-title="切换到上方工作区" { focus-workspace-up; }
    Mod+L     hotkey-overlay-title="聚焦右侧列" { focus-column-right; }

    Mod+Shift+Left  hotkey-overlay-title="左移列" { move-column-left; }
    Mod+Shift+Right hotkey-overlay-title="右移列" { move-column-right; }
    //Mod+Ctrl+Down  { move-window-down; }
    //Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+H     hotkey-overlay-title="左移列" { move-column-left; }
    Mod+Ctrl+J     hotkey-overlay-title="将窗口移到下方工作区" { move-window-to-workspace-down; }
    Mod+Ctrl+K     hotkey-overlay-title="将窗口移到上方工作区" { move-window-to-workspace-up; }
    Mod+Ctrl+L     hotkey-overlay-title="右移列" { move-column-right; }

    // 当列中到达第一个或最后一个窗口时，可使用跨工作区移动的替代命令。
    // Mod+J     { focus-window-or-workspace-down; }
    // Mod+K     { focus-window-or-workspace-up; }
    // Mod+Ctrl+J     { move-window-down-or-to-workspace-down; }
    // Mod+Ctrl+K     { move-window-up-or-to-workspace-up; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    Mod+Ctrl+Left  { focus-monitor-left; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Ctrl+Right { focus-monitor-right; }
    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+J     { focus-monitor-down; }
    Mod+Shift+K     { focus-monitor-up; }
    Mod+Shift+L     { focus-monitor-right; }

    Mod+Shift+Ctrl+Left  { move-workspace-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-workspace-down; }
    Mod+Shift+Ctrl+Up    { move-workspace-up; }
    Mod+Shift+Ctrl+Right { move-workspace-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-workspace-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-workspace-down; }
    Mod+Shift+Ctrl+K     { move-workspace-up; }
    Mod+Shift+Ctrl+L     { move-workspace-to-monitor-right; }

    // Alternatively, there are commands to move just a single window:
    // Mod+Shift+Ctrl+Left  { move-window-to-monitor-left; }
    // ...

    // And you can also move a whole workspace to another monitor:
    // Mod+Shift+Ctrl+Left  { move-workspace-to-monitor-left; }
    // ...

    Mod+Ctrl+Down      hotkey-overlay-title="将窗口移到下方工作区" { move-window-to-workspace-down; }
    Mod+Ctrl+UP        hotkey-overlay-title="将窗口移到上方工作区" { move-window-to-workspace-up; }
    // Mod+U              hotkey-overlay-title="切换到下方工作区" { focus-workspace-down; }
    // Mod+I              hotkey-overlay-title="切换到上方工作区" { focus-workspace-up; }
    Mod+Ctrl+Page_Down hotkey-overlay-title="将列移到下方工作区" { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   hotkey-overlay-title="将列移到上方工作区" { move-column-to-workspace-up; }
    Mod+Ctrl+U         hotkey-overlay-title="将窗口移到下方工作区" { move-window-to-workspace-down; }
    Mod+Ctrl+I         hotkey-overlay-title="将窗口移到上方工作区" { move-window-to-workspace-up; }

    // 同样，也有仅移动单个窗口到工作区的命令：
    // Mod+Ctrl+Page_Down { move-window-to-workspace-down; }
    // ...
    Mod+Ctrl+Alt+Down   hotkey-overlay-title="将窗口移到下方工作区" { move-window-to-workspace-down; }
    Mod+Ctrl+Alt+UP     hotkey-overlay-title="将窗口移到上方工作区" { move-window-to-workspace-up; }

    // 你可以使用以下语法绑定鼠标滚轮的滚动事件（tick）。
    // 这些绑定会根据 natural-scroll 设置改变方向。
    // 为避免快速遍历工作区，可以使用 cooldown-ms 属性。绑定会以该值限速。
    // 你可以对任意绑定设置冷却，但对滚轮来说最有用。
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Alt+WheelScrollDown  { focus-column-right; }
    Mod+Alt+WheelScrollUp    { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    // 通常在应用中按住 Shift 并上下滚动会产生水平滚动；这些绑定复现了该行为。
    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    // 同样，你可以绑定触控板的滚动“刻度”。
    // 触控板滚动是连续的，因此这些绑定会将其拆分为离散的区间。
    // 这些绑定也会受到触控板 natural-scroll 的影响；示例绑定为“反向”，
    // 因为默认对触控板启用了 natural-scroll。
    // Mod+TouchpadScrollDown { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.02+"; }
    // Mod+TouchpadScrollUp   { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.02-"; }

    // 你可以通过索引引用工作区。但请注意 niri 是动态工作区系统，
    // 因此这些命令属于“尽力而为”类型。尝试引用比当前工作区数量更大的索引
    // 时，会引用最下面（空）的工作区。
    //
    // 例如，若有 2 个工作区 + 1 个空工作区，则索引 3、4、5 等都会指向第 3 个工作区。
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    // Alternatively, there are commands to move just a single window:
    // Mod+Ctrl+1 { move-window-to-workspace 1; }

    // 在当前与上一个工作区之间切换焦点。
    // Mod+Tab { focus-workspace-previous; }

    // 以下绑定会将聚焦窗口移入或移出列。
    // 如果窗口是孤立的，它们会将其吞并到相邻的侧列。
    // 如果窗口已经在某列中，它们会将其弹出。
    Mod+BracketLeft  hotkey-overlay-title="左侧吞并或弹出窗口" { consume-or-expel-window-left; }
    Mod+BracketRight hotkey-overlay-title="右侧吞并或弹出窗口" { consume-or-expel-window-right; }

    // 打开或聚焦飞书。
    Mod+Comma hotkey-overlay-title="打开飞书" { spawn-sh "id=$(niri msg -j windows | jq -r '.[] | select((.app_id // \"\" | contains(\"feishu\")) or ((.title // \"\") | ascii_downcase | contains(\"feishu\")) or ((.title // \"\") | contains(\"飞书\"))) | .id' | head -n1); [ -n \"$id\" ] && niri msg action focus-window --id \"$id\" || exec feishu"; }
    // 将聚焦列底部的窗口弹出到右侧。
    Mod+Period { expel-window-from-column; }

    Mod+R hotkey-overlay-title="切换预设列宽" { switch-preset-column-width; }
    // Cycling through the presets in reverse order is also possible.
    // Mod+R { switch-preset-column-width-back; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+Ctrl+F hotkey-overlay-title="最大化列" { maximize-column; }
    Mod+Shift+F hotkey-overlay-title="全屏窗口" { fullscreen-window; }

    // 将聚焦列扩展为占用其他完全可见列未占用的空间。
    // 使该列"填充剩余空间"。
    // Mod+Ctrl+F { expand-column-to-available-width; }

    Mod+C { center-column; }

    // 在屏幕上居中所有完全可见的列。
    Mod+Alt+C { center-visible-columns; }

    // 更精细的宽度调整。
    // 该命令还可以：
    // * 以像素设置宽度: "1000"
    // * 以像素调整宽度: "-5" 或 "+5"
    // * 以屏幕宽度百分比设置宽度: "25%"
    // * 以屏幕宽度百分比调整宽度: "-10%" 或 "+10%"
    // 像素尺寸使用逻辑或缩放后的像素。例如在 scale 为 2.0 的输出上，
    // set-column-width "100" 将使列占用 200 个物理屏幕像素。
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    // 在与其他窗口同列时的更精细高度调整。
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // 在浮动布局与平铺布局之间切换聚焦窗口。
    Mod+W       hotkey-overlay-title="切换窗口浮动" { toggle-window-floating; }
    Mod+Shift+W hotkey-overlay-title="切换浮动与平铺焦点" { switch-focus-between-floating-and-tiling; }

    // 切换列的标签显示模式。
    // 该列中的窗口将以垂直标签的形式显示，
    // 而不是相互堆叠。
    // Mod+V { toggle-column-tabbed-display; }

    // 切换布局的操作。
    // 注意：如果取消注释这些，请确保上方的 xkb 选项中没有配置相同的布局切换热键。
    // 在同一热键上同时存在两者会导致切换失效，因为按下热键会触发两次切换（一次由 xkb，一次由 niri）。
    // Mod+Space       { switch-layout "next"; }
    // Mod+Shift+Space { switch-layout "prev"; }

    Mod+Shift+S hotkey-overlay-title="截图" { screenshot; }
    Ctrl+Print hotkey-overlay-title="截取屏幕" { screenshot-screen; }
    Alt+Print hotkey-overlay-title="截取窗口" { screenshot-window; }

    // 像远程桌面客户端或软件 KVM 切换这类应用，可能会请求 niri 停止处理此处定义的键盘快捷键，
    // 例如将按键原样转发到远程机器。绑定一个紧急开关来切换抑制器是个好主意，
    // 以免出错的应用把会话挂起。
    //
    // 属性 allow-inhibiting=false 也可以应用于其它绑定，
    // 以确保即使在抑制器激活时 niri 仍会处理这些绑定。
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // 退出动作会显示确认对话框以避免误退出。
    Mod+Shift+E hotkey-overlay-title="退出 Niri" { quit; }
    Ctrl+Alt+Delete hotkey-overlay-title="退出 Niri" { quit; }

    // 关闭显示器。要重新开启，进行任意输入，例如移动鼠标或按任意键。
    Mod+Shift+P hotkey-overlay-title="关闭显示器" { power-off-monitors; }
}
